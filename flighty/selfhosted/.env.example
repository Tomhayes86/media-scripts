# Required — flight schedule/status lookups
# Sign up at https://rapidapi.com/aedbx-aedbx/api/aerodatabox → subscribe to BASIC (free).
RAPIDAPI_KEY=

# Optional — improves OpenSky rate limits for live position tracking
# Create a free account at https://opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Required for push notifications on iPhone (Add to Home Screen PWA).
# Generate once with: docker compose run --rm flighty npm run gen-vapid
# Then paste the two keys here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Beelink timezone (affects log timestamps + cron)
TZ=Europe/London

# ---- Apple Wallet pass generation (optional) ----
# Skip these to keep just the in-app Wallet-style card. To enable real
# .pkpass files that install into Apple Wallet, see WALLET.md — you need:
#   1. Apple Developer account
#   2. A Pass Type ID + certificate exported as PEM
#   3. Files dropped into ./data/passkit/
# PASS_TYPE_ID=pass.com.yourdomain.flighty
# TEAM_ID=ABCDE12345
# ORG_NAME=Flighty
